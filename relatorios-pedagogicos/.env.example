# ============================================================
# RELATORIOS PEDAGOGICOS - Variaveis de ambiente
# ============================================================
# Copie este arquivo para `.env` e preencha com seus valores reais.
# NUNCA comite o arquivo .env (ja esta no .gitignore).
# ============================================================

# --- BANCO DE DADOS (Postgres / Supabase) ---
# DATABASE_URL: usado em runtime (queries do app). Em Supabase use o pooler 6543.
DATABASE_URL="postgres://postgres.SEU_PROJETO:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# DIRECT_DATABASE_URL: usado pelo Prisma para migrations / db push (porta 5432).
DIRECT_DATABASE_URL="postgres://postgres.SEU_PROJETO:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- AUTH E SEGURANCA ---
# Use strings longas, aleatorias e diferentes por ambiente.
JWT_SECRET="troque-por-uma-string-aleatoria-com-pelo-menos-32-caracteres"
AUDIT_LOG_SECRET="troque-por-outra-string-aleatoria-com-pelo-menos-32-caracteres"
MATRICULA_PEPPER="troque-por-um-segredo-aleatorio-para-hash-de-matriculas"

# --- LGPD / RETENCAO ---
# Ajuste conforme politica aprovada pela escola/controlador.
LGPD_DATA_RETENTION_DAYS="1825"

# --- (Opcional) Supabase API ---
# So preencha se for usar Supabase Storage / Auth direto pelo client.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
