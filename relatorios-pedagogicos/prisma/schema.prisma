generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                 Int        @id @default(autoincrement())
  nome               String     @db.VarChar(100)
  matricula          String     @unique @db.VarChar(20)
  email              String     @unique @db.VarChar(255)
  login              String?    @unique @db.VarChar(100)
  password           String     @db.VarChar(255)
  role               Role       @default(COORDENADOR)
  active             Boolean    @default(true)
  idTbProfessor      Int?       @unique @map("id_tb_professor")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  lastLoginAt        DateTime?  @map("last_login_at")
  professor          Professor?

  @@index([email], map: "idx_user_email")
  @@index([login], map: "idx_user_login")
  @@index([idTbProfessor], map: "idx_user_id_tb_professor")
  @@map("users")
}

model Professor {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(100)
  email          String?               @unique @db.VarChar(255)
  userId         Int?                  @unique
  matricula      String?               @db.VarChar(20)
  matricula_hash String?               @db.VarChar(64)
  login          String?               @unique @db.VarChar(100)
  role           Role                  @default(PROFESSOR)
  dataNascimento DateTime?             @map("data_nascimento")
  user           User?                 @relation(fields: [userId], references: [id])
  relatorios     Relatorio[]
  materias       Materia[]             @relation("ProfessorMateria")
  turmas         Turma[]               @relation("ProfessorTurma")
  accessCodes    ProfessorAccessCode[]

  @@index([name], map: "idx_professor_name")
  @@index([login], map: "idx_professor_login")
  @@map("professores")
}

model ProfessorAccessCode {
  id              Int       @id @default(autoincrement())
  professorId     Int       @map("professor_id")
  codeHash        String    @map("code_hash") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  attemptCount    Int       @default(0) @map("attempt_count")
  createdByUserId Int?      @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  professor       Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId, expiresAt], map: "idx_prof_access_code_prof_expires")
  @@index([usedAt], map: "idx_prof_access_code_used")
  @@map("professor_access_codes")
}

model Aluno {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  matricule       String?           @unique @db.VarChar(20)
  dataNascimento  DateTime?         @map("data_nascimento")
  active          Boolean           @default(true)
  turmaId         Int
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  turma           Turma             @relation(fields: [turmaId], references: [id])
  relatorios      Relatorio[]
  conceitosBimestrais ConceitoAlunoBimestre[]

  @@index([name], map: "idx_aluno_name")
  @@index([turmaId], map: "idx_aluno_turma")
  @@index([deletedAt], map: "idx_aluno_deleted")
  @@map("alunos")
}

model Materia {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(50)
  codigo      String?     @unique @db.VarChar(10)
  relatorios  Relatorio[]
  turmas      Turma[]     @relation("MateriaTurma")
  professores Professor[] @relation("ProfessorMateria")

  @@index([name], map: "idx_materia_name")
  @@map("materias")
}

model Turma {
  id           Int         @id @default(autoincrement())
  name         String      @unique @db.VarChar(10)
  anoLetivoId  Int
  anoLetivo    AnoLetivo   @relation(fields: [anoLetivoId], references: [id])
  alunos       Aluno[]
  relatorios   Relatorio[]
  materias     Materia[]   @relation("MateriaTurma")
  professores  Professor[] @relation("ProfessorTurma")

  @@index([name], map: "idx_turma_name")
  @@index([anoLetivoId], map: "idx_turma_ano_letivo")
  @@map("turmas")
}

model Relatorio {
  id          Int       @id @default(autoincrement())
  conteudo    String
  status      Status    @default(RASCUNHO)
  bimestreId  Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  alunoId     Int
  professorId Int
  materiaId   Int
  turmaId     Int
  aluno       Aluno     @relation(fields: [alunoId], references: [id])
  materia     Materia   @relation(fields: [materiaId], references: [id])
  professor   Professor @relation(fields: [professorId], references: [id])
  turma       Turma     @relation(fields: [turmaId], references: [id])
  bimestre    Bimestre  @relation(fields: [bimestreId], references: [id])

  @@unique([alunoId, professorId, materiaId, turmaId, bimestreId])
  @@index([alunoId], map: "idx_relatorio_aluno")
  @@index([professorId], map: "idx_relatorio_professor")
  @@index([materiaId], map: "idx_relatorio_materia")
  @@index([turmaId], map: "idx_relatorio_turma")
  @@index([bimestreId], map: "idx_relatorio_bimestre")
  @@index([createdAt], map: "idx_relatorio_created")
  @@index([deletedAt], map: "idx_relatorio_deleted")
  @@map("relatorios")
}

model LoginAudit {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  professorId  Int?     @map("professor_id")
  nome         String?  @db.VarChar(150)
  role         String   @db.VarChar(20)
  identifier   String   @db.VarChar(150)
  ip           String?  @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  success      Boolean  @default(false)
  message      String?  @db.VarChar(255)
  executedData String?  @map("executed_data")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_login_audit_created")
  @@index([userId], map: "idx_login_audit_user")
  @@index([professorId], map: "idx_login_audit_prof")
  @@index([success], map: "idx_login_audit_success")
  @@map("login_audit")
}

model AnoLetivo {
  id        Int       @id @default(autoincrement())
  ano       String    @unique @db.VarChar(4)
  ativo     Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  turmas    Turma[]
  bimestres Bimestre[]

  @@index([ano], map: "idx_ano_letivo")
  @@map("anos_letivos")
}

model Bimestre {
  id          Int         @id @default(autoincrement())
  numero      Int
  ativo       Boolean     @default(false)
  anoLetivoId Int
  anoLetivo   AnoLetivo   @relation(fields: [anoLetivoId], references: [id])
  relatorios  Relatorio[]
  conceitos   ConceitoAlunoBimestre[]

  @@unique([numero, anoLetivoId])
  @@index([anoLetivoId], map: "idx_bimestre_ano")
  @@map("bimestres")
}

model ConceitoAlunoBimestre {
  id         Int       @id @default(autoincrement())
  alunoId    Int
  bimestreId Int
  conceito   Conceito
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  aluno      Aluno     @relation(fields: [alunoId], references: [id])
  bimestre   Bimestre  @relation(fields: [bimestreId], references: [id])

  @@unique([alunoId, bimestreId])
  @@index([alunoId], map: "idx_conceito_aluno")
  @@index([bimestreId], map: "idx_conceito_bimestre")
  @@index([conceito], map: "idx_conceito_valor")
  @@map("conceitos_alunos_bimestres")
}

enum Role {
  COORDENADOR
  ADMIN
  PROFESSOR
}

enum Status {
  RASCUNHO
  ENVIADO
  REVISADO
  ARQUIVADO
}

enum Conceito {
  RI
  MB
  B
  R
}
