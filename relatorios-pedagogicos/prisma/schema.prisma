generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id          Int        @id @default(autoincrement())
  nome        String     @db.VarChar(100)
  matricula   String     @unique @db.VarChar(20)
  email       String     @unique @db.VarChar(255)
  password    String     @db.VarChar(255)
  role        Role       @default(COORDENADOR)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  lastLoginAt DateTime?  @map("last_login_at")
  professor   Professor?

  @@index([email], map: "idx_user_email")
  @@map("users")
}

model Professor {
  id             Int         @id @default(autoincrement())
  name           String      @db.VarChar(100)
  email          String?     @unique @db.VarChar(255)
  userId         Int?        @unique
  matricula      String?     @db.VarChar(20)
  matricula_hash String?     @db.VarChar(64)
  login          String?     @unique @db.VarChar(100)
  user           User?       @relation(fields: [userId], references: [id])
  relatorios     Relatorio[]
  materias       Materia[]   @relation("ProfessorMateria")
  turmas         Turma[]     @relation("ProfessorTurma")

  @@index([name], map: "idx_professor_name")
  @@index([login], map: "idx_professor_login")
  @@map("professores")
}

model Aluno {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  matricule       String?           @unique @db.VarChar(20)
  active          Boolean           @default(true)
  turmaId         Int
  turma           Turma             @relation(fields: [turmaId], references: [id])
  relatorios      Relatorio[]
  conceitosBimestrais ConceitoAlunoBimestre[]

  @@index([name], map: "idx_aluno_name")
  @@index([turmaId], map: "idx_aluno_turma")
  @@map("alunos")
}

model Materia {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(50)
  codigo      String?     @unique @db.VarChar(10)
  relatorios  Relatorio[]
  turmas      Turma[]     @relation("MateriaTurma")
  professores Professor[] @relation("ProfessorMateria")

  @@index([name], map: "idx_materia_name")
  @@map("materias")
}

model Turma {
  id           Int         @id @default(autoincrement())
  name         String      @unique @db.VarChar(10)
  anoLetivoId  Int
  anoLetivo    AnoLetivo   @relation(fields: [anoLetivoId], references: [id])
  alunos       Aluno[]
  relatorios   Relatorio[]
  materias     Materia[]   @relation("MateriaTurma")
  professores  Professor[] @relation("ProfessorTurma")

  @@index([name], map: "idx_turma_name")
  @@index([anoLetivoId], map: "idx_turma_ano_letivo")
  @@map("turmas")
}

model Relatorio {
  id          Int       @id @default(autoincrement())
  conteudo    String
  status      Status    @default(RASCUNHO)
  bimestreId  Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  alunoId     Int
  professorId Int
  materiaId   Int
  turmaId     Int
  aluno       Aluno     @relation(fields: [alunoId], references: [id])
  materia     Materia   @relation(fields: [materiaId], references: [id])
  professor   Professor @relation(fields: [professorId], references: [id])
  turma       Turma     @relation(fields: [turmaId], references: [id])
  bimestre    Bimestre  @relation(fields: [bimestreId], references: [id])

  @@unique([alunoId, professorId, materiaId, turmaId, bimestreId])
  @@index([alunoId], map: "idx_relatorio_aluno")
  @@index([professorId], map: "idx_relatorio_professor")
  @@index([materiaId], map: "idx_relatorio_materia")
  @@index([turmaId], map: "idx_relatorio_turma")
  @@index([bimestreId], map: "idx_relatorio_bimestre")
  @@index([createdAt], map: "idx_relatorio_created")
  @@map("relatorios")
}

model AnoLetivo {
  id        Int       @id @default(autoincrement())
  ano       String    @unique @db.VarChar(4)
  ativo     Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  turmas    Turma[]
  bimestres Bimestre[]

  @@index([ano], map: "idx_ano_letivo")
  @@map("anos_letivos")
}

model Bimestre {
  id          Int         @id @default(autoincrement())
  numero      Int
  ativo       Boolean     @default(false)
  anoLetivoId Int
  anoLetivo   AnoLetivo   @relation(fields: [anoLetivoId], references: [id])
  relatorios  Relatorio[]
  conceitos   ConceitoAlunoBimestre[]

  @@unique([numero, anoLetivoId])
  @@index([anoLetivoId], map: "idx_bimestre_ano")
  @@map("bimestres")
}

model ConceitoAlunoBimestre {
  id         Int       @id @default(autoincrement())
  alunoId    Int
  bimestreId Int
  conceito   Conceito
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  aluno      Aluno     @relation(fields: [alunoId], references: [id])
  bimestre   Bimestre  @relation(fields: [bimestreId], references: [id])

  @@unique([alunoId, bimestreId])
  @@index([alunoId], map: "idx_conceito_aluno")
  @@index([bimestreId], map: "idx_conceito_bimestre")
  @@index([conceito], map: "idx_conceito_valor")
  @@map("conceitos_alunos_bimestres")
}

enum Role {
  COORDENADOR
  ADMIN
  PROFESSOR
}

enum Status {
  RASCUNHO
  ENVIADO
  REVISADO
  ARQUIVADO
}

enum Conceito {
  RI
  MB
  B
  R
}
